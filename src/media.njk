---
layout: base.njk
permalink: "/media/"
title: "Médias"
description: "Photos et médias de Tous Ensemble C'est Nous : ateliers, émissions, événements avec les jeunes d'Aubervilliers."
---
<section id="media" class="first-section">
  <div class="media-intro reveal visible" style="transition-delay: 0s;">
    <div>
      <div class="section-label">{{ mediapage.label }}</div>
      <h2 class="section-title">{{ mediapage.title }}</h2>
      <p class="section-body">{{ mediapage.intro }}</p>
    </div>
  </div>

  <div class="media-grid">
    {% for photo in collections.photos %}
    <div class="media-tile reveal visible" style="transition-delay: 0s;">
      <img src="{{ photo.data.image }}" alt="{{ photo.data.caption }}">
    </div>
    {% endfor %}
  </div>

  <div class="media-cta reveal visible" style="transition-delay: 0s;">
    <a href="{{ settings.instagram_url }}" class="btn-primary">Voir plus sur Instagram</a>
    <span class="insta-handle">📸 {{ settings.instagram_handle }}</span>
  </div>
</section>
