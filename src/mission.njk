---
layout: base.njk
permalink: "/mission/"
title: "Notre mission"
description: "Réconcilier la jeunesse des quartiers populaires avec les médias, lutter contre la désinformation, surmonter la fracture sociale."
---
<section id="mission" class="first-section">
  <div class="reveal visible" style="transition-delay: 0s;">
    <div class="section-label">{{ mission.label }}</div>
    <h2 class="section-title">{{ mission.title | escape | nl2br }}</h2>
  </div>
  <div class="mission-grid">
    <div class="reveal visible" style="transition-delay: 0s;">
      <p class="section-body">{{ mission.intro }}</p>
      <div class="objectives-list" id="mission-objectifs">
        {% for o in mission.objectifs %}
        <div class="obj-item">
          <div class="obj-num">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</div>
          <div class="obj-text"><strong>{{ o.title }}</strong>{{ o.desc }}</div>
        </div>
        {% endfor %}
      </div>
    </div>
    <div class="mission-cta-box reveal visible" id="mission-cta" style="transition-delay: 0s;">
      <h3>{{ mission.cta_title }}</h3>
      <p>{{ mission.cta_text1 }}</p>
      <p>{{ mission.cta_text2 }}</p>
      <a href="/contact/" class="btn-primary">Nous contacter</a>
    </div>
  </div>
</section>
