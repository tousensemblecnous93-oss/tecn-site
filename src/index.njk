---
layout: base.njk
permalink: "/"
title: "Accueil"
description: "Tous Ensemble C'est Nous est une association culturelle et média basée à Aubervilliers : émission radio FOCUS, ateliers, actions de terrain pour la jeunesse des quartiers populaires."
---
<section id="hero">
  <div class="hero-bg"></div>
  <div class="hero-grid"></div>
  <div class="hero-content">
    <div class="hero-tag">{{ settings.hero_tag }}</div>
    <h1 class="hero-title">
      TOUS<br>
      <span class="grad-text">ENSEMBLE</span><br>
      C'EST NOUS!
    </h1>
    <p class="hero-sub">{{ settings.hero_intro }}</p>
    <div class="hero-cta">
      <a href="/actions/" class="btn-primary">Nos actions</a>
      <a href="/focus/" class="btn-outline">Émission FOCUS →</a>
    </div>
    <div class="hero-stats">
      <div>
        <div class="stat-num">2019</div>
        <div class="stat-label">Année de création</div>
      </div>
      <div>
        <div class="stat-num">27+</div>
        <div class="stat-label">Émissions diffusées</div>
      </div>
      <div>
        <div class="stat-num">20×</div>
        <div class="stat-label">Sorties radio mobile</div>
      </div>
      <div>
        <div class="stat-num">50+</div>
        <div class="stat-label">Jeunes accompagnés</div>
      </div>
    </div>
  </div>
</section>

<!-- LIVE WIDGET -->
<section id="live-widget">
  <div class="live-card reveal visible" style="transition-delay: 0s;">
    <div>
      <div class="live-badge"><span class="pulse"></span>À l'antenne</div>
      <div class="live-eyebrow">Émission FOCUS</div>
      <h3 class="live-title">Le portrait qui vous inspire</h3>
      <p class="live-sub">{{ settings.focus_schedule_text }}</p>
      <div class="live-actions">
        <a href="{{ settings.idfm_url }}" class="btn-primary">▶ Écouter en direct</a>
        <a href="/focus/" class="btn-outline">En savoir plus</a>
      </div>
    </div>
    <div class="live-wave" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
    </div>
  </div>
</section>
