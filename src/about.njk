---
layout: base.njk
permalink: "/about/"
title: "L'association"
description: "Qui sommes-nous : Tous Ensemble C'est Nous, association culturelle et d'éducation populaire fondée en 2019 à Aubervilliers par Sidy Kanté."
---
<section id="about" class="first-section">
  <div class="reveal visible" style="transition-delay: 0s;">
    <div class="section-label">{{ about.label }}</div>
    <h2 class="section-title">{{ about.title | escape | nl2br }}</h2>
    <p class="section-body">{{ about.intro }}</p>
    {% if about.agrements and about.agrements.length %}
    <p class="section-body" style="margin-top:1rem;">Agréments : {% for a in about.agrements %}<strong style="color:var(--light)">{{ a }}</strong>{% if not loop.last %} · {% endif %}{% endfor %}</p>
    {% endif %}
    {% if about.reseaux_fort %}
    <p class="section-body" style="margin-top:0.5rem;">Réseaux : <strong style="color:var(--light)">{{ about.reseaux_fort }}</strong>{% if about.reseaux_suite %} · {{ about.reseaux_suite }}{% endif %}</p>
    {% endif %}
  </div>
  <div class="about-visual reveal visible" style="transition-delay: 0s;">
    <div class="about-card">
      {% for v in about.values %}
      <div class="value-item">
        <div class="value-title">{{ v.title }}</div>
        <div class="value-desc">{{ v.desc }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
