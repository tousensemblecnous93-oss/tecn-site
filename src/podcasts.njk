---
layout: base.njk
permalink: "/podcasts/"
title: "Podcasts"
description: "Tous les épisodes du podcast FOCUS de Tous Ensemble C'est Nous, à écouter ou réécouter."
---
<section id="podcasts" class="first-section">
  <div class="reveal visible" style="transition-delay: 0s;">
    <div class="section-label">{{ podcastspage.label }}</div>
    <h2 class="section-title">{{ podcastspage.title }}</h2>
    <p class="section-body">{{ podcastspage.intro }}</p>
  </div>

  {% if collections.podcasts.length > 0 %}
  <div class="podcasts-grid">
    {% for ep in collections.podcasts %}
    <div class="podcast-card reveal visible" style="transition-delay: 0s;">
      {% set ytid = ep.data.video_url | youtubeId %}
      {% if ytid %}
      <div class="podcast-video">
        <iframe src="https://www.youtube.com/embed/{{ ytid }}" title="{{ ep.data.title }}" loading="lazy" allowfullscreen></iframe>
      </div>
      {% elif ep.data.video_file %}
      <div class="podcast-video">
        <video src="{{ ep.data.video_file }}" controls preload="metadata"></video>
      </div>
      {% elif ep.data.cover %}
      <div class="podcast-cover"><img src="{{ ep.data.cover }}" alt="{{ ep.data.title }}"></div>
      {% endif %}
      <div class="podcast-body">
        <div class="podcast-date">{{ ep.data.date | dateFr }}</div>
        <div class="podcast-title">{{ ep.data.title }}</div>
        <div class="podcast-desc">{{ ep.data.description }}</div>
        {% if ep.data.listen_url %}
        <a href="{{ ep.data.listen_url }}" class="podcast-listen">▶ Écouter l'épisode</a>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% else %}
  <div class="podcasts-empty">{{ podcastspage.empty }}</div>
  {% endif %}
</section>
