---
layout: base.njk
permalink: "/contact/"
title: "Contact"
description: "Contactez Tous Ensemble C'est Nous à Aubervilliers : email, Instagram, adresse."
---
<section id="contact" class="first-section">
  <div class="contact-inner reveal visible" style="transition-delay: 0s;">
    <div class="section-label">{{ contact.label }}</div>
    <h2 class="section-title">{{ contact.title }}</h2>
    <p class="section-body" style="margin: 0 auto 1rem;">{{ contact.intro }}</p>
    <div class="contact-info">
      <a href="mailto:{{ settings.contact_email }}" class="contact-item">
        <span class="contact-icon">✉️</span>
        {{ settings.contact_email }}
      </a>
      <a href="{{ settings.instagram_url }}" class="contact-item">
        <span class="contact-icon">📸</span>
        {{ settings.instagram_handle }}
      </a>
      <div class="contact-item">
        <span class="contact-icon">📍</span>
        {{ settings.contact_address }}
      </div>
    </div>
  </div>
</section>
