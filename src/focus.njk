---
layout: base.njk
permalink: "/focus/"
title: "FOCUS, l'émission"
description: "FOCUS, l'émission phare de Tous Ensemble C'est Nous, tous les vendredis de 21h à 22h sur IDFM Radio 98.0."
---
<section id="focus" class="first-section">
  <div class="focus-inner">
    <div class="reveal visible" style="transition-delay: 0s;">
      <div class="focus-badge">
        <span class="pulse"></span>
        {{ focus.badge }}
      </div>
      <div class="section-label">{{ focus.label }}</div>
      <h2 class="section-title">{{ focus.title }}</h2>
      <p class="section-body">{{ focus.intro }}</p>
      <div class="focus-schedule" id="focus-schedule">
        {% for row in focus.schedule %}
        <div class="schedule-row">
          <div class="schedule-dot"></div>
          <div class="schedule-text">{% if row.before %}{{ row.before }} {% endif %}<strong>{{ row.bold }}</strong>{% if row.after %} {{ row.after }}{% endif %}</div>
        </div>
        {% endfor %}
      </div>
    </div>
    <div class="focus-visual reveal visible" style="transition-delay: 0s;">
      <div class="focus-logo">FOCUS</div>
      <div class="focus-tagline">{{ focus.tagline }}</div>
      <div class="focus-fm">{{ focus.fm }}</div>
      <div class="focus-guests">
        {% for t in focus.tags %}
        <span class="guest-tag">{{ t }}</span>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
