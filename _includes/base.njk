<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} — {{ settings.site_title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ settings.site_url }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ title }} — {{ settings.site_title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ settings.site_url }}{{ page.url }}">
<meta property="og:image" content="{{ settings.site_url }}/assets/logo.png">
<meta property="og:locale" content="fr_FR">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ title }} — {{ settings.site_title }}">
<meta name="twitter:description" content="{{ description }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@600;700;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/styles.css?v=10">
{% if page.url == "/" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "{{ settings.site_title }}",
  "alternateName": "TECN",
  "url": "{{ settings.site_url }}/",
  "logo": "{{ settings.site_url }}/assets/logo.png",
  "description": "Association culturelle et d'éducation populaire à Aubervilliers : radio, médias, ateliers pour la jeunesse des quartiers populaires.",
  "email": "{{ settings.contact_email }}",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "166 Av. Victor Hugo",
    "postalCode": "93300",
    "addressLocality": "Aubervilliers",
    "addressCountry": "FR"
  },
  "sameAs": ["{{ settings.instagram_url }}"]
}
</script>
{% endif %}
</head>
<body>

<!-- NAV -->
<nav>
  <a href="/" style="display:flex; align-items:center; gap:0.7rem; text-decoration:none; flex-shrink:0;">
    <img src="/assets/logo.png" alt="Logo {{ settings.site_title }}" style="height:34px; width:auto;">
    <div class="nav-logo">TOUS ENSEMBLE C'EST NOUS</div>
  </a>
  <ul class="nav-links">
    <li class="has-dropdown">
      <a href="/about/">L'asso <span class="caret">▾</span></a>
      <ul class="dropdown">
        <li><a href="/about/">Qui sommes-nous</a></li>
        <li><a href="/mission/#mission-objectifs">Nos objectifs</a></li>
        <li><a href="/actions/">Nos actions</a></li>
      </ul>
    </li>
    <li class="has-dropdown">
      <a href="/actions/">Actions <span class="caret">▾</span></a>
      <ul class="dropdown">
        {% for a in collections.actionsList %}
        <li><a href="/actions/#{{ a.data.slug }}">{{ a.data.title }}</a></li>
        {% endfor %}
      </ul>
    </li>
    <li><a href="/focus/">Focus</a></li>
    <li><a href="/podcasts/">Podcasts</a></li>
    <li><a href="/media/">Médias</a></li>
    <li class="has-dropdown">
      <a href="/mission/">Mission <span class="caret">▾</span></a>
      <ul class="dropdown">
        <li><a href="/mission/">Nos constats</a></li>
        <li><a href="/mission/#mission-objectifs">Nos objectifs</a></li>
        <li><a href="/mission/#mission-cta">Rejoins l'aventure</a></li>
      </ul>
    </li>
    <li><a href="/partners/">Partenaires</a></li>
    <li class="has-dropdown">
      <a href="/mission/#mission-cta">Participer <span class="caret">▾</span></a>
      <ul class="dropdown">
        <li><a href="/mission/#mission-cta">Rejoindre les ateliers</a></li>
        <li><a href="/contact/">Proposer une interview</a></li>
      </ul>
    </li>
    <li><a href="/contact/">Contact</a></li>
  </ul>
  <button class="hamburger" aria-label="Ouvrir le menu" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
</nav>

{{ content | safe }}

<!-- FOOTER -->
<footer>
  <div style="display:flex; align-items:center; gap:0.6rem;">
    <img src="/assets/logo.png" alt="Logo {{ settings.site_title }}" style="height:26px; width:auto;">
    <div class="footer-logo">{{ settings.site_title }}!</div>
  </div>
  <div class="footer-copy">Association loi 1901 · Culture, Médias, ESS</div>
  <div class="footer-siret">{{ settings.siret }}</div>
</footer>

<script src="/js/main.js?v=10"></script>
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<script>
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("init", (user) => {
      if (!user) {
        window.netlifyIdentity.on("login", () => {
          document.location.href = "/admin/";
        });
      }
    });
    window.netlifyIdentity.on("logout", () => {
      document.location.href = "/";
    });
  }
</script>
</body>
</html>
